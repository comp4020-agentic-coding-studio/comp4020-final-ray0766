{
  "name": "comp4020-final",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test",
    "check:evidence": "node scripts/check-evidence.ts",
    "test": "vitest run",
    "dev": "vite",
    "dev:server": "node --watch src/server/index.ts",
    "build": "vite build",
    "start": "node src/server/index.ts",
    "lint": "eslint .",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/three": "^0.186.0",
    "eslint": "^10.12.0",
    "jsdom": "^30.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.1"
  },
  "engines": {
    "pnpm": ">=11",
    "node": ">=24"
  },
  "dependencies": {
    "marked": "^18.0.14",
    "three": "^0.186.1"
  }
}
